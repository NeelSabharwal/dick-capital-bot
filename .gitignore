# Secrets — NEVER commit these
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs (regenerated on every run)
bot.log

# Local Claude Code settings
.claude/

# NOTE: state.json and chat_state.json are intentionally NOT ignored.
# GitHub Actions commits them back after each run so the bot remembers
# which picks it has already posted (otherwise it would re-post everything
# on the next run, since each run starts on a fresh, empty machine).
